{
  "name": "promql",
  "scopeName": "source.promql",
  "comment": "Adapted from https://github.com/prometheus-community/vscode-promql (Apache-2.0).",
  "patterns": [
    { "name": "comment.line.number-sign.promql", "match": "#.*" },
    { "name": "string.quoted.double.promql", "match": "\"(\\\\.|[^\\\\\"])*\"" },
    { "name": "string.quoted.single.promql", "match": "'(\\\\.|[^\\\\'])*'" },
    { "name": "string.quoted.other.backticks.promql", "begin": "`", "end": "`" },
    { "name": "keyword.operator.binary.set.promql", "match": "\\b(and|or|unless)\\b" },
    {
      "name": "keyword.operator.aggregator.promql",
      "match": "\\b(sum|min|max|avg|stddev|stdvar|count|count_values|bottomk|topk|quantile|group)\\b"
    },
    {
      "name": "keyword.operator.keyword.selector.promql",
      "match": "\\b(by|without|offset|on|ignoring|group_left|group_right|bool)\\b"
    },
    {
      "name": "support.function.promql",
      "match": "\\b(abs|absent|absent_over_time|ceil|changes|clamp|clamp_max|clamp_min|day_of_month|day_of_week|day_of_year|days_in_month|delta|deriv|exp|floor|histogram_quantile|holt_winters|hour|idelta|increase|irate|label_join|label_replace|ln|log2|log10|minute|month|predict_linear|rate|resets|round|scalar|sgn|sort|sort_desc|sqrt|time|timestamp|vector|year|(avg|min|max|sum|count|quantile|stddev|stdvar|last|present)_over_time)(?=\\s*\\()"
    },
    {
      "name": "constant.numeric.range.promql",
      "match": "\\[[1-9][0-9]*(ms|s|m|h|d|w|y)(:([1-9][0-9]*(ms|s|m|h|d|w|y))?)?\\]"
    },
    { "name": "constant.numeric.promql", "match": "\\b[0-9]*\\.?[0-9]+([eE][-+]?[0-9]+)?\\b" },
    { "name": "keyword.operator.compare.promql", "match": "(=~|!~|!=|==|>=|<=|=|>|<)" },
    { "name": "keyword.operator.binary.arithmetic.promql", "match": "[-+*/%^]" },
    { "name": "variable.parameter.label.promql", "match": "[_a-zA-Z:][_a-zA-Z0-9:]*" },
    { "name": "punctuation.parentheses.begin.promql", "match": "\\(" },
    { "name": "punctuation.parentheses.end.promql", "match": "\\)" },
    { "name": "punctuation.separator.promql", "match": "," },
    { "name": "punctuation.braces.begin.promql", "match": "\\{" },
    { "name": "punctuation.braces.end.promql", "match": "\\}" }
  ]
}
